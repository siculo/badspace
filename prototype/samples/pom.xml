<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>badspace</groupId>
        <artifactId>badspace-prototype</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>badspace-samples</artifactId>
    <packaging>pom</packaging>
    <name>BADSPACE prototype - samples</name>
    <description>Sample clients that show how to use BADSPACE: one module for each aspect of the API and for each use case.</description>

    <!-- To run a sample, from the prototype directory:
         mvn install -DskipTests
         mvn -pl samples/<name> exec:java -->

    <modules>
        <module>spaces-and-partitions</module>
        <module>writes-and-commits</module>
        <module>snapshot-reads</module>
        <module>ticks-and-retention</module>
        <module>acquisition-timeouts</module>
        <module>ownership-handoff</module>
        <module>partition-removal</module>
        <module>entity-metadata</module>
        <module>partition-saves</module>
        <module>multi-writer</module>
        <module>writer-failover</module>
        <module>periodic-saves</module>
        <module>lagged-reader</module>
        <module>random-updater</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>badspace</groupId>
            <artifactId>badspace-api</artifactId>
        </dependency>
        <dependency>
            <groupId>badspace</groupId>
            <artifactId>badspace-service</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
