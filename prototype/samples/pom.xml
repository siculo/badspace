<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>badspace</groupId>
        <artifactId>badspace-prototype</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>badspace-samples</artifactId>
    <packaging>pom</packaging>
    <name>BADSPACE prototype - samples</name>
    <description>Sample clients that show how to use BADSPACE: one module with one program for each question about the API, in reading order.</description>

    <!-- Each sample builds and runs on its own. To run one, from the prototype directory:
         mvn install -DskipTests
         mvn -pl samples/<name> exec:java
         The persistence samples take an optional save directory:
         mvn -pl samples/<name> exec:java -Dexec.args=<directory> -->

    <modules>
        <module>getting-started</module>
        <module>partition-configuration</module>
        <module>three-dimensional-space</module>
        <module>batch-writes</module>
        <module>commits-and-ticks</module>
        <module>snapshot-queries</module>
        <module>snapshot-isolation</module>
        <module>snapshot-retention</module>
        <module>acquisition-timeouts</module>
        <module>ownership-handoff</module>
        <module>partition-removal</module>
        <module>entity-metadata</module>
        <module>conditional-writes</module>
        <module>save-and-load</module>
        <module>save-management</module>
        <module>concurrent-reader-writer</module>
        <module>multi-writer</module>
        <module>lagged-reader</module>
        <module>writer-failover</module>
        <module>periodic-saves</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>badspace</groupId>
            <artifactId>badspace-api</artifactId>
        </dependency>
        <dependency>
            <groupId>badspace</groupId>
            <artifactId>badspace-service</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
