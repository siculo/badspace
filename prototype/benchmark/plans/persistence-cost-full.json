// The measures to keep of the costs of the persistence, like persistence-cost-quick.json,
// with 1000, 10000 and 100000 entities, and the load with the linear scan, the uniform
// grid and the grid of quadtrees (octrees in 3D). Run the quick plan first, to check the
// memory and the time. It takes about 1 hour.
{
  "groups": [
    {
      "profile": "full",
      "report": "persistence-cost",
      "runs": [
        {
          "name": "persistence-copy-write",
          "include": "PersistenceBenchmark[23]\\.(copy|write)$",
          "params": {
            "size": [1000, 10000, 100000],
            "metadata": ["NONE", "FIXED"]
          }
        },
        {
          "name": "persistence-load",
          "index": ["LINEAR_SCAN", "UNIFORM_GRID_100", "GRID_QUADTREE_128"],
          "include": "PersistenceBenchmark[23]\\.load$",
          "params": {
            "size": [1000, 10000, 100000],
            "metadata": ["NONE", "FIXED"]
          }
        },
        {
          "name": "persistence-sizes",
          "include": "PersistenceSizes",
          "params": {
            "size": [1000, 10000, 100000],
            "metadata": ["NONE", "FIXED"]
          }
        }
      ]
    }
  ]
}
